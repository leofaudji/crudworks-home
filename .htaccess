DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to internal documentation, migrations, backups, and sensitive files
    RewriteRule ^(docs|scratch|backups|storage|scripts|\.git)(/.*)?$ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^(database\.sql|AGENTS\.md|composer\.(json|lock))$ - [F,L]
    RewriteRule \.(sql|log|ini|bak|sh|ps1)$ - [F,L]

    # Force trailing slash for the main directory
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

    # 1. API Routes
    RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

    # 2. Root/Index Handler (Always run index.php for cache busting injection)
    RewriteRule ^$ index.php [L]
    RewriteRule ^index\.html$ index.php [L]

    # 3. SPA Fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?!api/|assets/|manifest\.json|sw\.js).*$ index.php [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff
</IfModule>
