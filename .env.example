# ============================================================
# CRUDWorks ERP — Environment Configuration
# ============================================================

# Application Configuration
APP_NAME="CRUDWorks ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://crudworks-home.test

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crudworks_erp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Redis Configuration (Session & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0
REDIS_PREFIX="crudworks_"

# Security
SESSION_LIFETIME=86400
SESSION_NAME="CRUDWORKS_SESSID"

# Integrasi app-git (Deployer)
APP_GIT_PATH="d:/laragon/www/app-git"
APP_GIT_URL="http://app-git.test"
